# AI Code Reviewer Backend Production Environment Template
ENVIRONMENT=production
HOST=0.0.0.0
PORT=8000

# PostgreSQL Production Database Connection String
DATABASE_URL=postgresql://user:password@localhost:5432/ai_code_reviewer

# Authentication & Security
AUTH_SECRET=your-production-jwt-auth-secret-min-32-chars
GITHUB_TOKEN_ENCRYPTION_KEY=your-32-byte-fernet-key-urlsafe-base64

# GitHub OAuth Integration
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
GITHUB_REDIRECT_URI=https://your-domain.com/api/v1/github/callback

# Gemini AI Service
GEMINI_API_KEY=your-google-gemini-api-key
GEMINI_MODEL=gemini-1.5-pro

# CORS Allowed Origins (Comma-separated URLs)
ALLOWED_ORIGINS=https://your-domain.com,http://localhost:3000,http://127.0.0.1:3000
